(version 1)
(deny default)
(allow process*)
(allow sysctl-read)
(allow file-read*
    (subpath "/Library/Apple")
    (subpath "/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9")
    (subpath "/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin")
    (subpath "/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/lib")
    (subpath "/System")
    (subpath "/usr/lib")
    (subpath "/private/var/folders/18/6x97xlvs65gg9v7vkvlbpfkr0000gn/T/peerrole-canary-znrv8s0a/public")
    (literal "/dev/null") (literal "/dev/urandom"))
(allow file-write* (subpath "/private/var/folders/18/6x97xlvs65gg9v7vkvlbpfkr0000gn/T/peerrole-canary-znrv8s0a/public") (literal "/dev/null"))
